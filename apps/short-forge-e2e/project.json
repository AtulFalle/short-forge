{
  "name": "short-forge-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["short-forge"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/short-forge-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": ["short-forge:build", "short-forge:serve"]
    }
  }
}
